# Shop Inventory ERP - production settings
#
# On the server this file lives at /etc/erp/erp.env (owner erp, chmod 600).
# setup-server.sh creates it from this template and fills in the database password and
# JWT_SECRET itself, so you normally only check the values below and add the SEED_* lines once.
#
# Rules for this file (it is read by both systemd and Node):
#   - one KEY="value" per line, no spaces around "="
#   - do not use $ or # or " inside a value
#   - after any change: sudo systemctl restart erp
# Every setting is checked at start-up by apps/api/src/config.ts; a wrong value stops the app
# with "Invalid configuration ..." in the log (journalctl -u erp).

# --- Required ---------------------------------------------------------------

# PostgreSQL on the same server. The role erp_app is created by setup-server.sh
# (not a superuser, NOBYPASSRLS, owns the database shop_erp). Use letters/digits only in the
# password, or URL-encode it.
DATABASE_URL="postgresql://erp_app:CHANGE_ME@127.0.0.1:5432/shop_erp?schema=public"

# Signs the login tokens. At least 32 characters. Generate one with:
#   openssl rand -base64 48
# Changing it signs everybody out (they log in again).
JWT_SECRET="CHANGE_ME"

# The app listens here; Caddy forwards https://your-domain to it. Keep 3000 unless the
# Caddyfile is changed too. The firewall (ufw) keeps this port closed to the internet.
PORT=3000
# Only Caddy on this machine talks to the app (NFR-SEC-01: HTTPS only from outside)
HOST=127.0.0.1
# NFR-SEC-04: login attempts per IP address per 15 minutes (each account also locks after 5 wrong passwords)
# LOGIN_LIMIT_PER_IP=30

# --- Files ------------------------------------------------------------------

# Bill photos (FR-SCAN-08: every photo is kept as proof). Absolute path, writable by erp.
STORAGE_DIR="/var/lib/erp/storage"

# Built web app, relative to /opt/erp/current/apps/api. Leave as is.
WEB_DIST="../web/dist"

# --- Daily database backup (FR-SET-05) -------------------------------------

BACKUP_ENABLED=true
# Absolute path, writable by erp. pg_dump files (custom format) land here.
BACKUP_DIR="/var/lib/erp/backups"
# How many daily backups to keep on this server (1-365)
BACKUP_KEEP=14
# Hour of the day, Pakistan time (0-23)
BACKUP_HOUR=2
# pg_dump of the installed PostgreSQL (Ubuntu's wrapper picks the matching version)
PG_DUMP="/usr/bin/pg_dump"

# --- Sign-in (defaults shown) ----------------------------------------------

# ACCESS_TOKEN_TTL_SECONDS=3600
# FR-AUTH-01: session ends after this many days without use
# SESSION_IDLE_DAYS=30
# NFR-SEC-04: lock an account after this many wrong passwords, for this many minutes
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15

# --- Bill reading (AI) -----------------------------------------------------

# Only "demo" exists today (FR-AI-08): known sample bills are read from recorded results,
# every other photo opens in manual-entry mode.
AI_PROVIDER=demo
DEMO_FIXTURES_DIR="demo-fixtures"

# OPTIONAL - real AI bill reading (FR-AI-01/15, FR-SET-02). All of them can stay commented out:
# without a key the app keeps working in demo/manual mode. Each shop owner must also agree once
# (More -> AI settings) before photos are sent to the AI (FR-AI-16).
#   NFR-SEC-01: encrypts the AI keys shops save in their own settings. At least 32 characters
#   (openssl rand -base64 48). Empty = shops cannot save their own keys. Do not change it later,
#   or saved keys can no longer be read.
# AI_KEY_SECRET="CHANGE_ME"
#   FR-AI-15: the reader shops use by default on your (QSSols) key: none, openai or gemini
# HOSTED_AI_PROVIDER=none
#   Key of that provider (only the one you use)
# OPENAI_API_KEY="CHANGE_ME"
# GEMINI_API_KEY="CHANGE_ME"
#   Further optional tuning (defaults in apps/api/src/config.ts): OPENAI_MODEL, GEMINI_MODEL,
#   HOSTED_MONTHLY_SCANS (300 per shop per month), AI_TIMEOUT_MS (90000),
#   OPENAI_/GEMINI_PRICE_IN_/OUT_PER_MTOK (cost logging), OPENAI_/GEMINI_BASE_URL

# --- First shop and owner (used once by the seed command, see deploy/README.md) ---

# SEED_SHOP_NAME="My Shop"
# SEED_OWNER_NAME="Owner"
# SEED_OWNER_PHONE="03001234567"
# SEED_OWNER_PASSWORD="CHANGE_ME"
