{
  "name": "shop-inventory-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Shop Inventory ERP – Photo Scan (QSSols). Built to SRS v1.1.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspace @erp/domain && npm run build --workspace @erp/api",
    "test": "npm run test --workspace @erp/domain && npm run test --workspace @erp/api",
    "typecheck": "tsc -p packages/domain/tsconfig.json && npm run typecheck --workspace @erp/api",
    "db:validate": "npm run db:validate --workspace @erp/api",
    "build:all": "npm run build && npm run build --workspace @erp/web",
    "build:vercel": "node scripts/vercel-out.mjs",
    "demo:bills": "node apps/api/scripts/make-demo-bills.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "demo:record:en": "node scripts/record-demo.mjs --en"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "prisma@6.1.0": true,
    "@prisma/client@6.1.0": true,
    "@prisma/engines@6.1.0": true,
    "electron@45.2.3": true
  }
}
