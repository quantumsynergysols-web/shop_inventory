{
  "name": "@erp/api",
  "private": true,
  "version": "0.1.0",
  "description": "API server (NestJS). Does I/O and transactions; business rules come from @erp/domain.",
  "type": "module",
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "test": "tsc -p tsconfig.json && node --test --enable-source-maps \"dist/**/*.test.js\"",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "node --env-file-if-exists=.env ../../node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "db:seed": "node --env-file-if-exists=.env dist/seed.js",
    "test:db": "tsc -p tsconfig.json && node --env-file-if-exists=.env scripts/test-db.mjs"
  },
  "dependencies": {
    "@erp/domain": "*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "prisma": "6.1.0"
  }
}
